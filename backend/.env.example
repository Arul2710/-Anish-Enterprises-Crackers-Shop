# ---------------------------------------------------------------- server
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------- database
# Local standalone mongod works, but transactions require a replica set.
# For full transactional guarantees run: mongod --replSet rs0  then rs.initiate()
MONGODB_URI=mongodb://127.0.0.1:27017/anish_enterprises

# ---------------------------------------------------------------- cors + cookies
# Comma separated list of allowed browser origins.
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when the API is served over HTTPS.
SECURE_COOKIES=false
# Optional, e.g. .anishenterprises.com
COOKIE_DOMAIN=
# Set to 1 behind a reverse proxy so req.ip and secure cookies work.
TRUST_PROXY=false

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- first admin
# Used only by: npm run seed:admin   There is no public admin registration.
SEED_ADMIN_EMAIL=admin@anishenterprises.com
SEED_ADMIN_PASSWORD=change_me_to_a_strong_password
SEED_ADMIN_NAME=Shop Owner

# ---------------------------------------------------------------- image uploads
# memory  -> image uploads are refused, but image URLs may be supplied instead
# cloudinary -> files are streamed to Cloudinary and only the URL is stored
UPLOAD_STORAGE=memory
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------- excel import
IMPORT_SHEET_NAME=Order
IMPORT_NAME_COLUMN=name
IMPORT_SKU_COLUMN=sku
IMPORT_CATEGORY_COLUMN=category
IMPORT_PACK_COLUMN=pack
# Leave BOTH of these blank until the shop owner has confirmed which column is
# the customer-facing selling price. The API refuses to commit an import until
# this is confirmed in the admin UI; it is never guessed.
IMPORT_SELLING_PRICE_COLUMN=
IMPORT_ORIGINAL_PRICE_COLUMN=

# ---------------------------------------------------------------- shop defaults
SHOP_NAME=Anish Enterprises
SHOP_SUPPORT_PHONE=9442521144
SHOP_SUPPORT_EMAIL=anishenterprisessvk@gmail.com
MINIMUM_ORDER_AMOUNT=0
