{
    "name":  "spark-and-shine-frontend",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "predev":  "node scripts/image-manifest.mjs",
                    "dev":  "vite",
                    "prebuild":  "node scripts/image-manifest.mjs",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "lint":  "eslint src --ext js,jsx",
                    "typecheck":  "tsc -p jsconfig.json",
                    "test":  "node --import ./scripts/register-loader.mjs scripts/smoke-catalog.mjs && node --import ./scripts/register-loader.mjs scripts/smoke-orders.mjs && node --import ./scripts/register-loader.mjs scripts/smoke-notifications.mjs && node --import ./scripts/register-loader.mjs scripts/smoke-auth.mjs && node --import ./scripts/register-loader.mjs scripts/smoke-documents.mjs",
                    "test:catalog":  "node --import ./scripts/register-loader.mjs scripts/smoke-catalog.mjs",
                    "test:orders":  "node --import ./scripts/register-loader.mjs scripts/smoke-orders.mjs",
                    "test:notifications": "node --import ./scripts/register-loader.mjs scripts/smoke-notifications.mjs",
    "test:auth":  "node --import ./scripts/register-loader.mjs scripts/smoke-auth.mjs",
                    "test:documents":  "node --import ./scripts/register-loader.mjs scripts/smoke-documents.mjs",
                    "verify":  "npm run lint && npm run typecheck && npm run test && npm run build"
                },
    "dependencies":  {
                         "axios":  "^1.7.9",
                         "lucide-react":  "^0.468.0",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.28.1"
                     },
    "devDependencies":  {
                            "@vitejs/plugin-react":  "^4.3.4",
                            "autoprefixer":  "^10.4.20",
                            "eslint":  "^8.57.1",
                            "eslint-plugin-react":  "^7.37.2",
                            "eslint-plugin-react-hooks":  "^5.1.0",
                            "eslint-plugin-react-refresh":  "^0.4.16",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "typescript":  "^5.7.2",
                            "vite":  "^6.0.5"
                        }
}